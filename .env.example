# Copy to .env and adjust. All values optional.

# Port exposed on the host by docker compose
SHOPPER_PORT=8080

# Where the SQLite database lives inside the container (mounted volume)
DATA_DIR=/data

# --- Live price providers (optional) --------------------------------------
# Kroger family (Kroger, Fred Meyer, Ralphs, King Soopers, Fry's, Harris Teeter,
# Smith's, Dillons, QFC, Mariano's ...). Free developer keys:
#   https://developer.kroger.com  -> create an app with the "Products" API.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
